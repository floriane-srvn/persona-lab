{
  "name": "persona-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "chunk": "node scripts/chunk-corpus.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "index": "node --env-file=.env.local scripts/index-corpus.ts",
    "index:dry-run": "node --env-file=.env.local scripts/index-corpus.ts --dry-run",
    "search": "node --env-file=.env.local scripts/search.ts",
    "ask": "node --env-file=.env.local scripts/ask.ts",
    "reformulate": "node --env-file=.env.local scripts/reformulate.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5"
  }
}
